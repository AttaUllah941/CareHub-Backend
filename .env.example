# Server
NODE_ENV=development
PORT=5800
API_PREFIX=/api/v1

# MongoDB (local or Atlas)
# Local:  mongodb://localhost:27017/carehub
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/carehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/carehub
MONGODB_POOL_SIZE=50

# JWT (access token should be short-lived; refresh token longer)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma-separated)
# Production: CORS_ORIGIN=https://your-app.netlify.app
CORS_ORIGIN=http://localhost:4200
# Temporary: allow all https://*.netlify.app (set true on Render until site URL is known)
CORS_ALLOW_NETLIFY=false
# Production: FRONTEND_URL=https://your-app.netlify.app
FRONTEND_URL=http://localhost:4200

# Password Reset (token expiry in milliseconds, default 1 hour)
PASSWORD_RESET_EXPIRES_MS=3600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# File uploads — local disk or Cloudinary
STORAGE_PROVIDER=cloudinary
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=carehub

# Redis (Bull email queues — set REDIS_ENABLED=false on Render free tier)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# SMTP (required for real password-reset / notification emails)
# Without these, emails are logged only and local/dev returns a reset link in the API response.
# Example (Gmail): create an App Password, then:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password
#   SMTP_FROM="CareHub <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CareHub <noreply@carehub.local>

# AI assistant (CareHub AI) — keys stay on the server; never expose them to the frontend
# OPENAI_API_KEY is required for the assistant to answer; without it /ai/chat returns 503.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=45000
# AI_MAX_TOOL_ITERATIONS=5
# AI_HISTORY_MESSAGES=12
# AI_MAX_MESSAGE_CHARS=2000
# AI_RETENTION_DAYS=90
# AI_CONFIRMATION_TTL_MS=600000
# AI_CHAT_RATE_PER_MINUTE=20
# CLINIC_UTC_OFFSET=+05:00
# RAG (health & policy knowledge). Run `npm run ai:ingest` after editing files in /knowledge.
# AI_EMBEDDING_DIMENSIONS=512
# AI_RAG_TOP_K=4
# AI_RAG_MIN_SCORE=0.3
# AI_KNOWLEDGE_DIR=./knowledge

# Emergency only — never enable on a public production API
# PASSWORD_RESET_EXPOSE_TOKEN=true
